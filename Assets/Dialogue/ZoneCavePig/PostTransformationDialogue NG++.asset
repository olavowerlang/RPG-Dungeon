  m_Script: {fileID: 11500000, guid: 4df0014cb02a0cf4bbbc7addabd2224a, type: 3}
  m_Name: PostTransformationDialogue NG++
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Humberto
    text: Ta-dah!
  - speakerName: Humberto
    text: Yeah, you knew I would do this didn't you.
  - speakerName: Humberto
    text: Goddamn.
  - speakerName: Humberto
    text: How did you do this? Can you tell me ANYTHING?
  - speakerName: Humberto
    text: ...
  - speakerName: Humberto
    text: I don't know how you pulled this off kid, but I can't let it go on. I've
      waited way too much for this day!
  - speakerName: Humberto
    text: 'Ever since Gertrud imprisoned me in that disgraced form three hundred
      years ago I''ve met countless dumb lost adventurers like you, but none ever
      completed the potion! '
  - speakerName: Humberto
    text: 'I REFUSE to go back! '
  - speakerName: Humberto Garcia Sauvignon
    text: MEET THE FULL MIGHT OF HUMBERTO GARCIA SAUVIGNON!!!
