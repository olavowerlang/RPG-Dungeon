  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4df0014cb02a0cf4bbbc7addabd2224a, type: 3}
  m_Name: PostTransformationDialogue
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Pig?
    text: Ta-dah!
  - speakerName: Pig?
    text: ...
  - speakerName: Pig?
    text: Not what you expect?
  - speakerName: Pig?
    text: Well, it's not like I'm super excited to rock this skin either.
  - speakerName: Pig?
    text: Thing is the potion only works for transforming me into the closest human
      to me at the time of consumption.
  - speakerName: Pig?
    text: Couldn't exactly tell you that before, y'know?
  - speakerName: Pig?
    text: So, I got good news and bad news.
  - speakerName: Pig?
    text: Good news is, I'm very grateful for all your help.
  - speakerName: Pig?
    text: Bad news is, imma have to kill you right here.
  - speakerName: Pig?
    text: ...
  - speakerName: Pig?
    text: Can't exactly have two of us walking around, you know?
  - speakerName: Pig?
    text: ...
  - speakerName: Pig?
    text: Still nothing, really? I'm saying I AM GONNA HAVE TO KILL YOU. HELLO? ANY
      REACTION THERE? ANYBODY HOME???
  - speakerName: Pig?
    text: Jesus Christ man. Ok. Since I am actually grateful I am gonna make this
      quick. I won't enjoy this, if it makes you feel any better.
  - speakerName: Pig?
    text: Well then, prepare yourself!
