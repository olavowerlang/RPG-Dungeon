  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4df0014cb02a0cf4bbbc7addabd2224a, type: 3}
  m_Name: PostTransformationDialogue NG+
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Pig?
    text: Ta-dah!
  - speakerName: Pig?
    text: ...
  - speakerName: Pig?
    text: Wait, you don't seem surprised?
  - speakerName: Pig?
    text: You just saw a talking pig transform in a clone of you, and you don't even
      flinch. What in the seven hells is going on here?
  - speakerName: Pig?
    text: Plus, you already had the sword and dash...
  - speakerName: Pig?
    text: Son, did you travel back in time by any chance?
  - speakerName: Pig?
    text: ...it would be possible, this forest works in mysterious ways.
  - speakerName: Humberto
    text: I'm Humberto, by the way. Nice to meet you.
  - speakerName: Humberto
    text: So, unfortunately I'm gonna have to stop you right here. You're too dangerous.
  - speakerName: Humberto
    text: I'm grateful for your help though, so I am gonna make this quick.
  - speakerName: Humberto
    text: En garde!
